# Aave Crawler 配置示例
# 复制此文件为 config.yaml 并填写实际值（config.yaml 不会提交到版本控制）

# 日志文件等级
log_level: debug

# Base 网络 RPC 端点（留空则自动使用公共节点）
eth_rpc_url: ""
tron_rpc_url: ""

postgres:
  host: "127.0.0.1"
  port: 5432
  user: "your_pg_user"
  password: "your_pg_password"
  database: "your_database"

crawler:
  # 并发查询用户数（建议 10~30，过高会被 RPC 限速）
  concurrency: 20
  # 每批次处理完后写入 DB 的用户数
  batch_size: 100
  # 单次 RPC 调用超时（秒）
  rpc_timeout: 20
  # 失败重试次数
  retry_count: 3

makerdao:
  # 当前只支持 Ethereum 主网 MakerDAO/Sky MCD。
  chain: "ethereum"
  # MakerDAO 核心合约地址默认已在代码中硬编码；仅在需要覆盖主网地址或测试部署时填写。
  vat_address: ""
  spotter_address: ""
  dog_address: ""
  # 直接按 urn 地址查询时，用该白名单尝试识别 ilk；留空则使用代码内置主流 ilk。
  ilk_names: []
